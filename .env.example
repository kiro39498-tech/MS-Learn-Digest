# ══════════════════════════════════════════════════════════════════════════════
# MS Learn Digest — Environment Configuration Template
# ══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your actual values.
# Never commit the .env file — it contains secrets.
#
# This template shows the settings for LOCAL DEVELOPMENT.
# For PRODUCTION deployment on Render + Vercel, see the deployment checklist.
# ══════════════════════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────────────────────
# Local PostgreSQL instance. Docker Compose overrides this to use the 'db' service.
# Production (Render): use your Neon or Render PostgreSQL connection string.
DATABASE_URL=postgresql://user:password@localhost:5432/mslearndigest

# ── SMTP (Gmail) ──────────────────────────────────────────────────────────────
# Gmail SMTP for sending digest emails and magic-link logins.
# IMPORTANT: Use a Gmail App Password, NOT your account password.
#   1. Enable 2FA on your Google account.
#   2. Generate an App Password at: https://myaccount.google.com/apppasswords
#   3. Paste the 16-character code (without spaces) below.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Get these from Google Cloud Console → Credentials → OAuth 2.0 Client IDs.
# Register BOTH redirect URIs in the Google Cloud Console:
#   - http://localhost:8000/auth/google/callback     (for local dev)
#   - https://ms-learn-digest.onrender.com/auth/google/callback  (for production)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# Backend OAuth callback URL — MUST match what's registered in Google Cloud Console.
# Local:      http://localhost:8000/auth/google/callback
# Production: https://ms-learn-digest.onrender.com/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Frontend origin — used by the backend for CORS and email link generation.
# Local:      http://localhost:5173
# Production: https://ms-learn-digest-git-learnings-kiro9898.vercel.app
FRONTEND_URL=http://localhost:5173

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins for CORS.
# If not set, falls back to FRONTEND_URL.
# Local:       ALLOWED_ORIGINS=http://localhost:5173
# Production:  ALLOWED_ORIGINS=https://ms-learn-digest-git-learnings-kiro9898.vercel.app
# Both:        ALLOWED_ORIGINS=http://localhost:5173,https://ms-learn-digest-git-learnings-kiro9898.vercel.app
ALLOWED_ORIGINS=http://localhost:5173

# ── Groq AI ───────────────────────────────────────────────────────────────────
# Get a free API key at: https://console.groq.com
GROQ_API_KEY=gsk_your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
# Microsoft Learn MCP enriches Learning lessons only.
# Do not use MCP for catalog sync, topic discovery, modules, or progress.
MCP_SERVER_URL=https://learn.microsoft.com/api/mcp
MCP_TIMEOUT=10
MCP_RETRIES=2
MCP_CACHE_TTL=86400

# ── JWT ───────────────────────────────────────────────────────────────────────
# Secret key for signing JWT tokens. Generate a random 32+ character string.
# CRITICAL: Change this to a strong random value in production.
JWT_SECRET_KEY=change-this-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=72

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=MS Learn Digest
APP_ENV=development
LOG_LEVEL=INFO
ADMIN_ENABLED=true

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# Backend API base URL used by the React frontend.
# Local:      http://localhost:8000
# Production: https://ms-learn-digest.onrender.com
VITE_API_URL=http://localhost:8000

# Google Client ID (same as above, exposed to frontend)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
