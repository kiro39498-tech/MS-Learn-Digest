# ══════════════════════════════════════════════════════════════════════════════
# MS Learn Digest — Frontend Environment Variables (Vite)
# ══════════════════════════════════════════════════════════════════════════════
# Vite only exposes variables prefixed with VITE_ to the browser.
# All other variables (without VITE_) are server-side only.
#
# For LOCAL DEVELOPMENT:
#   1. Copy this file to frontend/.env (or the project root .env)
#   2. Fill in your values.
#
# For PRODUCTION (Vercel):
#   Set these variables in Vercel Dashboard → Your Project → Settings → Environment Variables.
#   DO NOT commit .env to git.
# ══════════════════════════════════════════════════════════════════════════════

# Backend API base URL — used by the Axios client in src/services/api.js.
# Local:      VITE_API_URL=http://localhost:8000
# Production: VITE_API_URL=https://ms-learn-digest.onrender.com
VITE_API_URL=http://localhost:8000

# Google OAuth 2.0 Client ID — used on the login page to initiate the OAuth flow.
# Same value as GOOGLE_CLIENT_ID in the backend .env.
# Get from: Google Cloud Console → Credentials → OAuth 2.0 Client IDs
# Add to Authorised JavaScript Origins in Google Cloud Console:
#   - http://localhost:5173           (local dev)
#   - https://ms-learn-digest-git-learnings-kiro9898.vercel.app  (production)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
