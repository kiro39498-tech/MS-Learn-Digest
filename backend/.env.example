# ══════════════════════════════════════════════════════════════════════════════
# MS Learn Digest — Backend Environment Variables (FastAPI / Render)
# ══════════════════════════════════════════════════════════════════════════════
# For LOCAL DEVELOPMENT:
#   Values can live in the project root .env file (three levels above config.py).
#   Alternatively, copy this file to backend/.env (not recommended; use root .env).
#
# For PRODUCTION (Render):
#   Set all variables in Render Dashboard → Your Service → Environment.
#   The .env file is NOT present on Render — pydantic-settings reads env vars directly.
# ══════════════════════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────────────────────
# Local:      postgresql://user:password@localhost:5432/mslearndigest
# Production: Use your Neon / Render PostgreSQL connection string.
DATABASE_URL=postgresql://user:password@localhost:5432/mslearndigest

# ── SMTP (Gmail) ──────────────────────────────────────────────────────────────
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-secret

# The redirect URI sent to Google during the token exchange.
# MUST be registered in Google Cloud Console → Credentials → Authorised Redirect URIs.
# Local:      http://localhost:8000/auth/google/callback
# Production: https://ms-learn-digest.onrender.com/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# The frontend origin. Used in:
#   - Email magic-link URLs
#   - Team invitation email URLs
#   - CORS fallback (when ALLOWED_ORIGINS is not set)
# Local:      http://localhost:5173
# Production: https://ms-learn-digest-git-learnings-kiro9898.vercel.app
FRONTEND_URL=http://localhost:5173

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of frontend origins that may call the API.
# If not set, FRONTEND_URL is used as a single-origin fallback.
# Example (both envs): http://localhost:5173,https://ms-learn-digest-git-learnings-kiro9898.vercel.app
ALLOWED_ORIGINS=http://localhost:5173

# ── Groq AI ───────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# ── JWT ───────────────────────────────────────────────────────────────────────
# Must be a long, random, secret string. Never share or commit.
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=72

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=MS Learn Digest
APP_ENV=development          # Set to "production" on Render
LOG_LEVEL=INFO
ADMIN_ENABLED=true           # Set to false in production to lock /api/admin/*
